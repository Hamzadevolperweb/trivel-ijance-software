# Public Supabase project settings (publishable key only; safe for browser use).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only secret; used only for the one-time admin bootstrap and staff invitations.
# Never prefix this with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=""

# Set temporarily for the first administrator bootstrap, then remove it.
INITIAL_ADMIN_PASSWORD=""
